---
import Layout from '~/layouts/PageLayout.astro';
import ProductCard from '~/components/products/ProductCard.astro';
import products from '~/data/products.json';
const query = Astro.url.searchParams.get('q')?.trim() ?? '';
const normalized = query.toLocaleLowerCase('es');
const items = products.filter((product) => product.status === 'published' && (!normalized || [product.title.es, product.description.es, product.brand, product.category].some((value) => value.toLocaleLowerCase('es').includes(normalized))));
const metadata = { title: 'Catálogo | WhereToBuy', description: 'Explorá productos y encontrá tiendas donde comprarlos.' };
---
<Layout metadata={metadata}>
  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8">
    <div class="mb-10 max-w-2xl">
      <p class="text-sm font-bold uppercase tracking-[0.18em] text-teal-700">CATÁLOGO</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">Productos para descubrir</h1>
      <p class="mt-4 text-lg leading-8 text-slate-600">Explorá productos seleccionados y encontrá enlaces a tiendas externas. WhereToBuy no vende directamente.</p>
      <form action="/products/" method="GET" class="mt-6 flex gap-3 rounded-2xl border border-slate-200 bg-white p-2 shadow-sm">
        <input type="search" name="q" value={query} placeholder="Buscar por producto, marca o categoría…" aria-label="Buscar catálogo" class="min-w-0 flex-1 rounded-xl px-4 py-3 text-slate-900 outline-none focus:ring-2 focus:ring-teal-500"/>
        <button type="submit" class="rounded-xl bg-slate-900 px-5 py-3 font-semibold text-white transition hover:bg-teal-700">Buscar</button>
      </form>
    </div>
    {query && <p class="mb-6 text-sm text-slate-600">Resultados para <strong>“{query}”</strong>: {items.length}</p>}
    {items.length ? <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{items.map((product) => <ProductCard product={product} lang="es" />)}</div> : <div class="rounded-2xl border border-dashed border-slate-300 p-10 text-center"><h2 class="text-xl font-semibold text-slate-900">No encontramos productos</h2><p class="mt-2 text-slate-600">Probá con otra búsqueda. Estamos ampliando el catálogo.</p><a href="/products/" class="mt-5 inline-flex font-semibold text-teal-700 hover:underline">Ver todo el catálogo →</a></div>}
  </section>
</Layout>
---
import Layout from '~/layouts/PageLayout.astro';
import products from '~/data/products.json';
export function getStaticPaths() {
  return products.filter((product) => product.status === 'published').map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
const { product } = Astro.props;
const title = product.title.es;
const description = product.description.es;
const metadata = { title: `${title} | WhereToBuy`, description };
---
<Layout metadata={metadata}>
  <main class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
    <a href="/products/" class="text-sm font-semibold text-teal-700 hover:underline">← Volver al catálogo</a>
    <div class="mt-8 grid gap-10 lg:grid-cols-2 lg:items-start">
      <div class="overflow-hidden rounded-3xl bg-slate-100">
        <img src={product.image} alt={title} class="aspect-square w-full object-cover" />
      </div>
      <div>
        {product.demo && <span class="inline-flex rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-800">PRODUCTO DE DEMOSTRACIÓN</span>}
        <p class="mt-5 text-sm font-bold uppercase tracking-[0.18em] text-teal-700">{product.brand} · {product.category}</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-950">{title}</h1>
        <p class="mt-5 text-lg leading-8 text-slate-600">{description}</p>
        <section class="mt-8 rounded-2xl border border-slate-200 p-5">
          <h2 class="text-lg font-semibold text-slate-900">Dónde encontrarlo</h2>
          <p class="mt-2 text-sm text-slate-500">Los enlaces de esta ficha son de demostración; no representan una oferta ni un precio verificado.</p>
          {product.stores.map((store) => <a href={store.url} target="_blank" rel="noopener noreferrer nofollow" class="mt-4 flex items-center justify-between rounded-xl bg-teal-700 px-5 py-4 font-semibold text-white transition hover:bg-teal-800">{store.name} <span aria-hidden="true">↗</span></a>)}
        </section>
        <p class="mt-6 text-xs leading-5 text-slate-500">WhereToBuy es un catálogo de descubrimiento. La compra, disponibilidad, envío y condiciones dependen de la tienda externa.</p>
      </div>
    </div>
  </main>
</Layout>

---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import ProductCard from '~/components/products/ProductCard.astro';
import products from '~/data/products.json';
const items = products.filter((product) => product.status === 'published');
const metadata = { title: 'WhereToBuy — Discover products, find stores', description: 'Discover selected products and find external stores where you can buy them.' };
---
<Layout metadata={metadata}>
  <Fragment slot="header"><Header links={[{ text: 'Home', href: '/en/' }, { text: 'Catalog', href: '/en/products/' }, { text: 'Español', href: '/' }]} isSticky showToggleTheme /></Fragment>
  <section class="relative overflow-hidden bg-slate-950">
    <div class="absolute inset-0 bg-gradient-to-br from-slate-950 via-slate-900 to-teal-950"></div>
    <div class="relative mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-28">
      <span class="inline-flex rounded-full border border-teal-400/30 bg-teal-400/10 px-4 py-2 text-sm font-medium text-teal-200">Global product discovery</span>
      <h1 class="mt-7 max-w-3xl text-5xl font-bold tracking-tight text-white sm:text-7xl">Discover it.<br/><span class="text-teal-300">Find where to buy.</span></h1>
      <p class="mt-6 max-w-xl text-lg leading-8 text-slate-300">Explore products selected for you and find links to stores around the world. We help you discover; retailers handle the purchase.</p>
      <a href="/en/products/" class="mt-9 inline-flex rounded-full bg-teal-400 px-7 py-3.5 font-semibold text-slate-950 transition hover:bg-teal-300">Explore catalog <span class="ml-2">→</span></a>
    </div>
  </section>
  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8">
    <div class="mb-9 flex items-end justify-between gap-4">
      <div><p class="text-sm font-bold uppercase tracking-[0.18em] text-teal-700">CURATED PICKS</p><h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Products to explore</h2></div>
      <a href="/en/products/" class="text-sm font-semibold text-teal-700 hover:underline">View catalog →</a>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{items.map((product) => <ProductCard product={product} lang="en" />)}</div>
  </section>
  <section class="mx-auto max-w-7xl px-5 pb-16 sm:px-8"><div class="rounded-3xl bg-slate-100 p-8 sm:p-12"><p class="text-sm font-bold uppercase tracking-[0.18em] text-teal-700">HOW IT WORKS</p><h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950">A simpler way to discover</h2><div class="mt-8 grid gap-6 sm:grid-cols-3"><div><span class="text-2xl font-bold text-teal-700">01</span><h3 class="mt-2 font-semibold text-slate-900">Discover</h3><p class="mt-1 text-sm leading-6 text-slate-600">Browse thoughtfully selected products.</p></div><div><span class="text-2xl font-bold text-teal-700">02</span><h3 class="mt-2 font-semibold text-slate-900">Compare</h3><p class="mt-1 text-sm leading-6 text-slate-600">Review product details and store options.</p></div><div><span class="text-2xl font-bold text-teal-700">03</span><h3 class="mt-2 font-semibold text-slate-900">Visit a retailer</h3><p class="mt-1 text-sm leading-6 text-slate-600">Continue your purchase on the store's website.</p></div></div></div></section>
</Layout>

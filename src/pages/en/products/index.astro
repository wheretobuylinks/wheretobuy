---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import ProductCard from '~/components/products/ProductCard.astro';
import products from '~/data/products.json';
const query = Astro.url.searchParams.get('q')?.trim() ?? '';
const normalized = query.toLocaleLowerCase('en');
const items = products.filter((product) => product.status === 'published' && (!normalized || [product.title.en, product.description.en, product.brand, product.category].some((value) => value.toLocaleLowerCase('en').includes(normalized))));
const metadata = { title: 'Catalog | WhereToBuy', description: 'Explore products and find stores where you can buy them.' };
---
<Layout metadata={metadata}>
  <Fragment slot="header"><Header links={[{ text: 'Home', href: '/en/' }, { text: 'Catalog', href: '/en/products/' }, { text: 'Español', href: '/' }]} isSticky showToggleTheme /></Fragment>
  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8">
    <div class="mb-10 max-w-2xl"><p class="text-sm font-bold uppercase tracking-[0.18em] text-teal-700">CATALOG</p><h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">Products to discover</h1><p class="mt-4 text-lg leading-8 text-slate-600">Explore selected products and find links to external retailers. WhereToBuy does not sell directly.</p>
      <form action="/en/products/" method="GET" class="mt-6 flex gap-3 rounded-2xl border border-slate-200 bg-white p-2 shadow-sm"><input type="search" name="q" value={query} placeholder="Search products, brands or categories…" aria-label="Search catalog" class="min-w-0 flex-1 rounded-xl px-4 py-3 text-slate-900 outline-none focus:ring-2 focus:ring-teal-500"/><button type="submit" class="rounded-xl bg-slate-900 px-5 py-3 font-semibold text-white transition hover:bg-teal-700">Search</button></form>
    </div>
    {query && <p class="mb-6 text-sm text-slate-600">Results for <strong>“{query}”</strong>: {items.length}</p>}
    {items.length ? <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{items.map((product) => <ProductCard product={product} lang="en" />)}</div> : <div class="rounded-2xl border border-dashed border-slate-300 p-10 text-center"><h2 class="text-xl font-semibold text-slate-900">No products found</h2><p class="mt-2 text-slate-600">Try another search. We’re growing the catalog.</p><a href="/en/products/" class="mt-5 inline-flex font-semibold text-teal-700 hover:underline">View all products →</a></div>}
  </section>
</Layout>
---
import Layout from '~/layouts/PageLayout.astro';
import ProductCard from '~/components/products/ProductCard.astro';
import products from '~/data/products.json';
const items = products.filter((product) => product.status === 'published');
const metadata = { title: 'Catalog | WhereToBuy', description: 'Explore products and find stores where you can buy them.' };
---
<Layout metadata={metadata}>
  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8">
    <div class="mb-10 max-w-2xl"><p class="text-sm font-bold uppercase tracking-[0.18em] text-teal-700">CATALOG</p><h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">Products to discover</h1><p class="mt-4 text-lg leading-8 text-slate-600">Explore selected products and find links to external retailers. WhereToBuy does not sell directly.</p></div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{items.map((product) => <ProductCard product={product} lang="en" />)}</div>
  </section>
</Layout>

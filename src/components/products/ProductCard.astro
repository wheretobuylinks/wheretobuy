---
const { product, lang = 'es' } = Astro.props;
const title = product.title[lang] ?? product.title.es;
const description = product.description[lang] ?? product.description.es;
const href = lang === 'en' ? `/en/products/${product.slug}/` : `/products/${product.slug}/`;
---
<article class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
  <a href={href} class="block" aria-label={title}>
    <div class="relative aspect-[4/3] overflow-hidden bg-slate-100">
      <img src={product.image} alt={title} loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
      {product.demo && <span class="absolute left-3 top-3 rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800">{lang === 'en' ? 'DEMO PRODUCT' : 'PRODUCTO DEMO'}</span>}
    </div>
    <div class="p-5">
      <p class="mb-2 text-xs font-semibold uppercase tracking-[0.15em] text-teal-700">{product.brand} · {product.category}</p>
      <h3 class="text-lg font-semibold tracking-tight text-slate-900">{title}</h3>
      <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-600">{description}</p>
      <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-teal-700">{lang === 'en' ? 'View product' : 'Ver producto'} <span aria-hidden="true">→</span></span>
    </div>
  </a>
</article>
